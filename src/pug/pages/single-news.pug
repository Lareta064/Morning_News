extends ../layouts/layout-news.pug

block content
	.page-wrapper
		//=====HEADER======
		include ../sections/_header.pug
		//=====MAIN=====
		main.single-news-main
			//=======HERO section ====
			include ../sections/_single-news-hero.pug
			section.aside-right
				.aside-right__content
					//=======содержание новости ====
					include ../sections/_single-news-content
					//=======аннонс новости ====
					include ../sections/_announce-news
					//=======social-news ====
					include ../sections/_social-news
					//=======partners-news-cards ====
					include ../sections/_partners-news-cards
				.aside-right__sidebar.hide-tablet
					.aside-article
						h2.border-header Самое читаемое
						+news-card-aside('read-news', '', 'Глашатай истин роковых',  'Это внутреннее дело Французской республики... Если я правильно помню, это не является новацией в политических технологиях Французской республики.', '2240', '160')(class="news-card--mini")
						+news-card-aside('read-news', '', 'Глашатай истин роковых',  'Это внутреннее дело Французской республики... Если я правильно помню, это не является новацией в политических технологиях Французской республики.', '240', '160')(class="news-card--mini")
						+news-card-aside('read-news', '', 'Глашатай истин роковых',  'Это внутреннее дело Французской республики... Если я правильно помню, это не является новацией в политических технологиях Французской республики.', '240', '160')(class="news-card--mini")

					.aside-article
						h2.border-header Новости экономики 
						
						+news-card-aside('news2', '', 'Ястреб в отпуске',  'ЦБ подождет с повышением ставки до конца июля, когда это может и не понадобиться', '240', '160')(class="news-card--mini")
						+news-card-aside('news2', '', 'Ястреб в отпуске',  'ЦБ подождет с повышением ставки до конца июля, когда это может и не понадобиться', '240', '160')(class="news-card--mini")
					.aside-article
						+news-card-aside('partners-news', '', 'Тренер «Рубина» Рахимов отреагировал на ничью с «Ростовом»',  '', '225', '160')(class="news-card--midi")
						+news-card-aside('partners-news', '', 'Тренер «Рубина» Рахимов отреагировал на ничью с «Ростовом»',  '', '225', '160')(class="news-card--midi")
						+news-card-aside('partners-news', '', 'Тренер «Рубина» Рахимов отреагировал на ничью с «Ростовом»',  '', '225', '160')(class="news-card--midi")


					
		//=======FOOTER ====
		include ../sections/_footer.pug
	
block variables
	-var title = "Содержание новости";
